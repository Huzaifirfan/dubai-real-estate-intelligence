	partition FactTransactions = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents(SourceFile),
				        [Delimiter = ",", Columns = 41, Encoding = 65001, QuoteStyle = QuoteStyle.Csv, ExtraValues = ExtraValues.Error]
				    ),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    ExpectedColumns = {"TRANSACTION_NUMBER", "INSTANCE_DATE", "GROUP_EN", "PROCEDURE_EN", "IS_OFFPLAN_EN", "IS_FREE_HOLD_EN", "USAGE_EN", "AREA_EN", "PROP_TYPE_EN", "PROP_SB_TYPE_EN", "TRANS_VALUE", "PROCEDURE_AREA", "ACTUAL_AREA", "ROOMS_EN", "PARKING", "NEAREST_METRO_EN", "NEAREST_MALL_EN", "NEAREST_LANDMARK_EN", "TOTAL_BUYER", "TOTAL_SELLER", "MASTER_PROJECT_EN", "PROJECT_EN", "TRANSACTION_DATE", "TRANSACTION_YEAR", "TRANSACTION_MONTH", "TRANSACTION_MONTH_NAME", "TRANSACTION_QUARTER", "TRANSACTION_DAY", "TRANSACTION_DAY_NAME", "TRANSACTION_HOUR", "IS_SALE_TRANSACTION", "IS_RESIDENTIAL_FLAG", "IS_OFFPLAN_FLAG", "IS_FREEHOLD_FLAG", "PROPERTY_SIZE_SQFT", "VALID_SALE_PRICE_METRIC", "SALE_PRICE_PER_SQM", "SALE_PRICE_PER_SQFT", "TRANSACTION_VALUE_BAND", "PROPERTY_SIZE_BAND", "BEDROOM_COUNT"},
				    CheckedSchema = if Table.ColumnNames(Headers) = ExpectedColumns
				        then Headers
				        else error "The Stage 10 source schema differs from the expected 41 columns.",
				    Typed = Table.TransformColumnTypes(
				        CheckedSchema,
				        {
				            {"TRANSACTION_NUMBER", type text},
				            {"INSTANCE_DATE", type datetime},
				            {"GROUP_EN", type text},
				            {"PROCEDURE_EN", type text},
				            {"IS_OFFPLAN_EN", type text},
				            {"IS_FREE_HOLD_EN", type text},
				            {"USAGE_EN", type text},
				            {"AREA_EN", type text},
				            {"PROP_TYPE_EN", type text},
				            {"PROP_SB_TYPE_EN", type text},
				            {"TRANS_VALUE", type number},
				            {"PROCEDURE_AREA", type number},
				            {"ACTUAL_AREA", type number},
				            {"ROOMS_EN", type text},
				            {"PARKING", type text},
				            {"NEAREST_METRO_EN", type text},
				            {"NEAREST_MALL_EN", type text},
				            {"NEAREST_LANDMARK_EN", type text},
				            {"TOTAL_BUYER", Int64.Type},
				            {"TOTAL_SELLER", Int64.Type},
				            {"MASTER_PROJECT_EN", type text},
				            {"PROJECT_EN", type text},
				            {"TRANSACTION_DATE", type date},
				            {"TRANSACTION_YEAR", Int64.Type},
				            {"TRANSACTION_MONTH", Int64.Type},
				            {"TRANSACTION_MONTH_NAME", type text},
				            {"TRANSACTION_QUARTER", type text},
				            {"TRANSACTION_DAY", Int64.Type},
				            {"TRANSACTION_DAY_NAME", type text},
				            {"TRANSACTION_HOUR", Int64.Type},
				            {"IS_SALE_TRANSACTION", Int64.Type},
				            {"IS_RESIDENTIAL_FLAG", Int64.Type},
				            {"IS_OFFPLAN_FLAG", Int64.Type},
				            {"IS_FREEHOLD_FLAG", Int64.Type},
				            {"PROPERTY_SIZE_SQFT", type number},
				            {"VALID_SALE_PRICE_METRIC", Int64.Type},
				            {"SALE_PRICE_PER_SQM", type number},
				            {"SALE_PRICE_PER_SQFT", type number},
				            {"TRANSACTION_VALUE_BAND", type text},
				            {"PROPERTY_SIZE_BAND", type text},
				            {"BEDROOM_COUNT", Int64.Type}
				        },
				        "en-US"
				    ),
				    ValueBandOrder = [#"Under 500K" = 1, #"500K - 1M" = 2, #"1M - 2M" = 3, #"2M - 5M" = 4, #"5M - 10M" = 5, #"10M+" = 6],
				    SizeBandOrder = [#"Under 50 sqm" = 1, #"50 - 100 sqm" = 2, #"100 - 200 sqm" = 3, #"200 - 500 sqm" = 4, #"500+ sqm" = 5],
				    SortedValueBands = Table.AddColumn(Typed, "TRANSACTION_VALUE_BAND_SORT", each Record.FieldOrDefault(ValueBandOrder, [TRANSACTION_VALUE_BAND], 99), Int64.Type),
				    SortedSizeBands = Table.AddColumn(SortedValueBands, "PROPERTY_SIZE_BAND_SORT", each Record.FieldOrDefault(SizeBandOrder, [PROPERTY_SIZE_BAND], 99), Int64.Type)
				in
				    SortedSizeBands

	annotation PBI_ResultType = Table

